# ExitFleet manager HTTP listener.
EXITFLEET_MANAGER_HOST=0.0.0.0
EXITFLEET_MANAGER_PORT=8787

# VPNGate-compatible source used by the manager node refresh endpoint.
EXITFLEET_VPNGATE_URL=https://www.vpngate.net/api/iphone/

# First proxy port allocated by manager-launched exits.
EXITFLEET_PROXY_BASE_PORT=7928

# Worker health/readiness listener and default TUN device.
EXITFLEET_WORKER_PROXY_HOST=0.0.0.0
EXITFLEET_WORKER_PROXY_PORT=7928
EXITFLEET_WORKER_TUN_DEVICE=tun0

# Worker OpenVPN process settings used when the real runner is introduced.
EXITFLEET_OPENVPN_CMD=openvpn
EXITFLEET_OPENVPN_AUTH_FILE=

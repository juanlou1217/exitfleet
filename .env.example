# ExitFleet manager HTTP listener.
EXITFLEET_MANAGER_HOST=0.0.0.0
EXITFLEET_MANAGER_PORT=8787

# VPNGate-compatible source used by the manager node refresh endpoint.
EXITFLEET_VPNGATE_URL=https://www.vpngate.net/api/iphone/

# First proxy port allocated by manager-launched exits.
EXITFLEET_PROXY_BASE_PORT=7928

# Docker worker lifecycle. Build the image locally with:
# docker build -f Dockerfile.worker -t exitfleet-worker:local .
EXITFLEET_DOCKER_CMD=docker
EXITFLEET_DOCKER_WORKER_IMAGE=exitfleet-worker:local
EXITFLEET_DOCKER_CONTAINER_PREFIX=exitfleet-worker
EXITFLEET_DOCKER_NETWORK=

# Worker SOCKS5 listener and default TUN device.
EXITFLEET_WORKER_PROXY_HOST=0.0.0.0
EXITFLEET_WORKER_PROXY_PORT=7928
EXITFLEET_WORKER_PROXY_OUTBOUND_IP=
EXITFLEET_WORKER_SOCKS_MAX_CONNECTIONS=200
EXITFLEET_WORKER_TUN_DEVICE=tun0

# Worker health/readiness listener and probe policy.
EXITFLEET_WORKER_HEALTH_HOST=0.0.0.0
EXITFLEET_WORKER_HEALTH_PORT=8790
EXITFLEET_WORKER_HEALTH_URLS=
EXITFLEET_WORKER_HEALTH_FAIL_THRESHOLD=3
EXITFLEET_WORKER_HEALTH_INTERVAL_SECONDS=10
EXITFLEET_WORKER_HEALTH_TIMEOUT_SECONDS=8

# Worker OpenVPN process settings used when the real runner is introduced.
EXITFLEET_OPENVPN_CMD=openvpn
EXITFLEET_OPENVPN_AUTH_FILE=
